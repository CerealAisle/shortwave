{
  "name": "lovense-discord-bot",
  "version": "1.4.1",
  "private": true,
  "description": "Private Discord bot bridging Discord message events to Lovense toys via the Lovense Cloud (Standard Server) API.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "deploy-commands": "node dist/discord/deploy-commands.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --env-file=.env.test --test \"dist/**/*.test.js\"",
    "test:watch": "node --env-file=.env.test --test --watch \"dist/**/*.test.js\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  }
}
