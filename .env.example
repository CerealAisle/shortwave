# ---------- Discord ----------
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
DISCORD_GUILD_ID=your-private-server-id
# Shared conversation channel. Messages here trigger a buzz while a session
# is armed. The bot stays close to silent in it.
MAIN_CHANNEL_ID=channel-id
# The bot's home: every bot-initiated message (disconnects, resumes, errors)
# goes here. Must differ from MAIN_CHANNEL_ID. Commands work in both channels
# and reply wherever they were run.
COMMAND_CHANNEL_ID=channel-id

# ---------- Lovense ----------
LOVENSE_TOKEN=your-lovense-developer-token
# Random secret used to derive a per-user utoken. Generate with:
#   openssl rand -hex 32
USER_TOKEN_SALT=change-me-to-32-plus-random-hex-chars

# ---------- Callback server ----------
# Lovense Remote POSTs toy status here. Must be reachable from the internet
# (see README: Cloudflare Tunnel). Port is local only.
CALLBACK_PORT=4000
CALLBACK_PATH=/lovense/callback
CALLBACK_BIND=127.0.0.1

# Running a staging instance too? Give it a DIFFERENT port and path, so the
# Cloudflare tunnel can route to both and switching between them is a single
# field in the Lovense dashboard. Staging uses:
#     CALLBACK_PORT=4001
#     CALLBACK_PATH=/staging/callback
# See STAGING.md.

# ---------- Storage ----------
DATABASE_PATH=./data/bot.db
# One JSON file per /pattern; the filename is the pattern's name.
PATTERNS_DIR=./patterns

# ---------- Behaviour ----------
# Buzz sent on each qualifying message
BUZZ_INTENSITY_PERCENT=50
BUZZ_DURATION_SEC=1.5

# Hard ceiling applied to every command, including manual ones
MAX_INTENSITY_PERCENT=100

# Rate limiting: protects the toy owner from message floods and stays
# inside Lovense's API limits.
MIN_COMMAND_INTERVAL_MS=1500
MAX_COMMANDS_PER_MINUTE=25

# Tease has no auto-off: it is driven by the other person's messages, so a
# session nobody is paying attention to produces nothing by itself. Instead,
# while tease is on, a reminder posts to the command channel this often, with
# the buzz count and whether the toy is reachable. 0 disables.
TEASE_REMINDER_MINUTES=30

# After /stop, nothing that moves can start for this many minutes — no buzz,
# pattern or tease, from anyone. /stop duration:<minutes> overrides it for
# one use. A later /stop can extend the lockout but never shorten it.
STOP_LOCKOUT_MINUTES=3

# ---------- Liveness (tuned for iOS) ----------
# Requires "heartbeat" to be enabled in the Lovense developer dashboard.
# A link is considered offline if no heartbeat has arrived in this many
# seconds. iOS suspends background apps, so heartbeats arrive in clusters
# with gaps rather than on a clean interval — hence the generous default.
# Set to 0 to disable liveness tracking entirely.
HEARTBEAT_TIMEOUT_SEC=300

# How often to sweep for links that have gone quiet, and for due probes.
PRESENCE_POLL_SEC=15

# Active liveness probe — the primary presence signal. Each linked toy is
# sent Vibrate:0 for ~1.1s (nothing moves) and Lovense's answer says whether
# a real command would land right now. Never sent while something is running
# on the toy. Backs off to the offline interval while a toy is unreachable.
# Set PROBE_INTERVAL_SEC=0 to disable and rely on heartbeats alone.
PROBE_INTERVAL_SEC=300
PROBE_OFFLINE_INTERVAL_SEC=900

# When the toy drops offline mid-session, the session is PAUSED and resumes
# by itself if the toy returns within this window. Only after it closes is
# the session disarmed. Set to 0 to disarm on the first blip instead.
OFFLINE_GRACE_SEC=300

# iOS often drops the first command sent to a freshly-woken app. Retry a
# retryable failure (507 / network) this many times before giving up.
WAKE_RETRY_ATTEMPTS=2
WAKE_RETRY_DELAY_MS=700

# ---------- Disconnect notifications ----------
# DM the toy's owner when their link drops. The channel message is easy to
# miss on a phone; a DM raises a push notification, which is what actually
# reaches the person who has to force-quit and reopen the Lovense app.
DM_ON_DISCONNECT=true
# Minimum gap between disconnect DMs for the same person, so a flapping
# connection doesn't become a notification storm. The "session disarmed" DM
# ignores this — by then the session has genuinely ended.
DM_COOLDOWN_SEC=600

# Trigger on messages from other bots/webhooks?
TRIGGER_ON_BOT_MESSAGES=false

LOG_LEVEL=info
