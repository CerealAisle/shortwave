{
  // Use the TypeScript version from node_modules, not the one bundled with
  // VS Code, so the editor and `npm run typecheck` agree.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  "editor.formatOnSave": true,
  "editor.rulers": [80],
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // Keep build output and runtime state out of search results and the tree.
  "files.exclude": {
    "dist": true,
    "node_modules": true
  },
  "search.exclude": {
    "dist": true,
    "node_modules": true,
    "package-lock.json": true
  },

  // Shell scripts in deploy/ are bash, not sh.
  "[shellscript]": { "editor.defaultFormatter": null }
}
