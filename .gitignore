# Dependencies and build output
node_modules/
dist/
coverage/

# Runtime state — the SQLite database holds toy links
data/
*.db
*.db-wal
*.db-shm

# Credentials. .env.example and .env.test hold only placeholders and ARE
# committed; any other .env file is real and must never be.
.env
.env.*
!.env.example
!.env.test

# Logs and editor noise
*.log
npm-debug.log*
.DS_Store
.idea/

# Editor config: share the two files that keep everyone's setup consistent,
# ignore the per-machine rest (launch targets, local state).
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
